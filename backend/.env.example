# Copy to backend/.env for local development. Everything here is optional locally.

# --- Required in production ---
# APP_ENV=production
# SECRET_KEY=            # long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
# CORS_ORIGINS=https://your-frontend.vercel.app
# FRONTEND_URL=https://your-frontend.vercel.app
# DB_PATH=/data/app.db           # on a persistent volume
# MEDIA_DIR=/data/media

# --- Email (pick one; with neither, emails are written to the in-app outbox only) ---
# EMAIL_FROM="Fireflies Clone <notifications@yourdomain.com>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# RESEND_API_KEY=

# --- Optional features ---
# GOOGLE_CLIENT_ID=      # enables "Continue with Google"
# AI summaries and written Ask Fred answers (any OpenAI-compatible provider; Groq by default):
# LLM_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=https://api.groq.com/openai/v1
# Recordings uploaded without a transcript are transcribed with the same provider and key (Whisper):
#   STT_MODEL=whisper-large-v3-turbo      # Groq; 25 MB per recording; speakers are not told apart
# Other providers, including free tiers (set LLM_BASE_URL and LLM_MODEL):
#   Google Gemini (free key from aistudio.google.com):
#     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     LLM_MODEL=gemini-2.5-flash
#   Groq (free key from console.groq.com):
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#     LLM_MODEL=openai/gpt-oss-120b
# DEMO_LOGIN_ENABLED=true
# SEED_ON_STARTUP=true
# MAX_MEDIA_MB=200
